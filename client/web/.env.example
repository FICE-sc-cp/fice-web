# Backend the /api-proxy and /uploads rewrites forward to. Read at build time.
BACKEND_URL=http://localhost:3001

# Backend for server-side (SSR/RSC) fetches.
INTERNAL_API_URL=http://localhost:3001

# Student bot username without "@", inlined at build time (projector QR,
# "open the bot" link). In Docker it is built from USER_BOT_USERNAME.
NEXT_PUBLIC_USER_BOT_USERNAME=
