generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String @id @default(uuid()) @db.Uuid
  telegramTag String @unique @db.VarChar(50)
}

model StatOverride {
  key       String   @id @db.VarChar(50)
  value     Decimal  @db.Decimal(14, 2)
  updatedAt DateTime @default(now()) @updatedAt
}

model SiteSetting {
  key       String   @id @db.VarChar(50)
  value     String   @db.VarChar(200)
  updatedAt DateTime @default(now()) @updatedAt
}

enum NewsCategory {
  EVENTS
  EDUCATION
  PARTNERS
  CHARITY
  ACHIEVEMENTS
}

model News {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(50)
  // A future date keeps the news off the site until then (a scheduled post).
  publishDate DateTime      @default(now())
  details     String?       @db.Text
  image       String?
  category    NewsCategory?

  // Optional event-announcement fields. When eventDate is set the news item is
  // rendered as an event announcement with a registration call-to-action.
  eventDate        DateTime?
  eventLocation    String?   @db.VarChar(100)
  registrationLink String?
  // Label of the button under a news item that links somewhere other than an
  // event registration (registrationLink without eventDate).
  buttonText       String?   @db.VarChar(64)
  isDraft          Boolean   @default(false)
  // The big card on the news page, one post at a time. When none is chosen,
  // or the chosen one is a draft or scheduled, the latest post takes it.
  isFeatured       Boolean   @default(false)
}

enum ChannelPostStatus {
  // Asked for in the media chat by someone without access; waits for approval.
  PENDING
  SCHEDULED
  PUBLISHED
  FAILED
}

// A post for the Telegram channel, published right away or at publishAt.
model ChannelPost {
  id              String            @id @default(uuid()) @db.Uuid
  // HTML for parse_mode=HTML.
  text            String            @db.Text
  // Picture, GIF or video from the admin panel: /uploads/… or an https URL.
  imageUrl        String?
  // Media of a post taken from the media chat, sent again by its file id.
  mediaFileId     String?
  mediaType       String?           @db.VarChar(16)
  buttonText      String?           @db.VarChar(64)
  buttonUrl       String?
  // Link buttons one per row, e.g. votes for nominations; used instead of the one above.
  buttons         Json?
  publishAt       DateTime
  status          ChannelPostStatus @default(SCHEDULED)
  messageId       Int?
  error           String?
  author          String?           @db.VarChar(100)
  // The message in MEDIA_POST_CHAT_ID it came from; the bot reports there.
  sourceMessageId Int?
  createdAt       DateTime          @default(now())

  @@index([status, publishAt])
}

// People allowed to publish from the media chat without approval. The media
// department head and the presidium grant it and always have it themselves.
model Publisher {
  telegramTag String   @id @db.VarChar(50)
  addedBy     String?  @db.VarChar(100)
  createdAt   DateTime @default(now())
}

enum FundraiserStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model Fundraiser {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(120)
  status         FundraiserStatus
  description    String           @db.VarChar(255)
  story          String?          @db.Text
  imageUrl       String?
  location       String?          @db.VarChar(100)
  goalAmount     Decimal          @db.Decimal(14, 2)
  currentAmount  Decimal          @db.Decimal(14, 2)
  cardNumber     String?          @db.VarChar(25)
  jarUrl         String?
  jarWidgetUrl   String?          @db.VarChar(500)
  jarHasGoal     Boolean          @default(false)
  jarSyncedAt    DateTime?
  jarSyncError   String?          @db.VarChar(255)
  startDate      DateTime?
  endDate        DateTime?
  detailsLink    String?
}

model DepartmentHead {
  id             String  @id @default(uuid()) @db.Uuid
  firstName      String  @db.VarChar(30)
  lastName       String  @db.VarChar(30)
  photo          String?
  photoFocusX    Int     @default(50)
  photoFocusY    Int     @default(50)
  photoZoom      Int     @default(100)
  jobDescription String? @db.VarChar(100)
  telegramTag    String? @db.VarChar(50)

  department Department?
}

model Department {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @db.VarChar(50)
  slug           String? @unique @db.VarChar(32)
  shortName      String? @db.VarChar(50)
  memberCount    Int?
  // Telegram chat the bot harvests this department's people wall from.
  // "chatId" or "chatId/threadId" for a forum topic. Set from the admin panel.
  telegramChatId String? @db.VarChar(64)
  // Length of one interview slot; set by the department head in the interview bot.
  interviewSlotMinutes Int @default(30)

  headId String?         @unique @db.Uuid
  head   DepartmentHead? @relation(fields: [headId], references: [id], onDelete: SetNull)

  applicantDepartments        ApplicantDepartment[]
  departmentMemberAssignments DepartmentMemberAssignment[]
  eventDetails                EventDetails[]
  projectParticipants         ProjectParticipant[]
  interviewRecruiters         InterviewRecruiter[]
  interviewCandidates         InterviewCandidate[]
  interviewSlots              InterviewSlot[]
}

enum DepartmentMemberRole {
  DEPUTY
  HR
  HEAD
  MEMBER
  FIRST_DEPUTY
  SECRETARY
}

model DepartmentMember {
  id             String               @id @default(uuid()) @db.Uuid
  role           DepartmentMemberRole
  firstName      String               @db.VarChar(30)
  lastName       String               @db.VarChar(30)
  specialization String?              @db.VarChar(100)
  title          String?              @db.VarChar(100)
  description    String?              @db.Text
  order          Int                  @default(0)
  photo          String?
  photoFocusX    Int                  @default(50)
  photoFocusY    Int                  @default(50)
  photoZoom      Int                  @default(100)
  telegramTag    String?              @db.VarChar(50)

  assignments DepartmentMemberAssignment[]
}

model DepartmentMemberAssignment {
  id           String @id @default(uuid()) @db.Uuid
  departmentId String @db.Uuid
  memberId     String @db.Uuid

  department Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  member     DepartmentMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Applicant {
  id          String   @id @default(uuid()) @db.Uuid
  firstName   String   @db.VarChar(30)
  middleName  String   @db.VarChar(30)
  lastName    String   @db.VarChar(30)
  telegramTag String   @db.VarChar(50)
  group       String   @db.VarChar(20)
  phoneNumber String   @db.VarChar(20)
  motivation  String?  @db.Text
  experience  String?  @db.Text
  createdAt   DateTime @default(now())

  applicantDepartments ApplicantDepartment[]
  interviewCandidates  InterviewCandidate[]
}

model ApplicantDepartment {
  id           String  @id @default(uuid()) @db.Uuid
  applicantId  String  @db.Uuid
  departmentId String  @db.Uuid
  question     String? @db.Text

  applicant  Applicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model EventDetails {
  id             String  @id @default(uuid()) @db.Uuid
  description    String  @db.VarChar(255)
  moneyCollected Decimal @db.Decimal(10, 2)
  charityAmount  Decimal @db.Decimal(10, 2)
  visitorsAmount Int?

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  event Event?
}

model Event {
  id       String   @id @default(uuid()) @db.Uuid
  name     String   @db.VarChar(50)
  date     DateTime
  photoUrl String?

  description           String?   @db.Text
  location              String?   @db.VarChar(120)
  locationNote          String?   @db.Text
  timeNote              String?   @db.VarChar(120)
  registrationCloseDate DateTime?
  maxRegistrations      Int?
  photoAlbumUrl         String?
  // Livestream before/during the event, recording after it.
  streamUrl             String?
  feeAmount             Decimal?  @db.Decimal(10, 2)
  feeAtEventAmount      Decimal?  @db.Decimal(10, 2)
  donationAnyAmount     Boolean   @default(false)
  // The contribution is welcome but people may register without it.
  donationOptional      Boolean   @default(false)
  feeRequisites         String?   @db.VarChar(255)
  isAbitfest            Boolean   @default(false)
  noRegistration        Boolean   @default(false)
  isDraft               Boolean   @default(false)
  hasTime               Boolean   @default(true)
  time                  String?   @db.VarChar(10)
  allowedFaculties      String[]  @default([])
  checkInStaffTags      String[]  @default([])
  checkInStaffIds       BigInt[]  @default([])
  baseQuestionsConfig   Json?

  detailsId String?       @unique @db.Uuid
  details   EventDetails? @relation(fields: [detailsId], references: [id], onDelete: SetNull)

  eventPartners          EventPartner[]
  program                EventProgramItem[]
  questions              EventQuestion[]
  registrations          EventRegistration[]
  votings                EventVoting[]
  broadcasts             BroadcastMessage[]
  pendingWebRegistrations PendingWebRegistration[]
}

model BlockedUser {
  id             String   @id @default(uuid()) @db.Uuid
  telegramTag    String   @unique @db.VarChar(50)
  telegramUserId BigInt?
  group          String?  @db.VarChar(20)
  faculty        String?  @db.VarChar(50)
  reason         String?  @db.Text
  isBlocked      Boolean  @default(true)
  blockedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PendingWebRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  token       String   @unique @db.VarChar(64)
  eventId     String   @db.Uuid
  payload     Json
  telegramTag String   @db.VarChar(50)
  expiresAt   DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([telegramTag])
}

model EventProgramItem {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  time    String @db.VarChar(20)
  title   String @db.VarChar(120)
  order   Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum EventQuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  YES_NO
  FILE
}

enum QuestionFileKind {
  IMAGE
  VIDEO
  PDF
  WORD
}

model EventQuestion {
  id        String             @id @default(uuid()) @db.Uuid
  eventId   String             @db.Uuid
  label     String             @db.VarChar(200)
  type      EventQuestionType  @default(SHORT_TEXT)
  required  Boolean            @default(false)
  options   String[]
  fileKinds QuestionFileKind[] @default([])
  maxFiles  Int                @default(1)
  order     Int                @default(0)

  event   Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers EventRegistrationAnswer[]
}

enum RegistrationSource {
  WEB
  BOT
  // Added by an organizer in the admin panel.
  ADMIN
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
  REJECTED
}

enum RegistrationPayment {
  NONE
  DONATED
  AT_EVENT
}

model EventRegistration {
  id                     String              @id @default(uuid()) @db.Uuid
  eventId                String              @db.Uuid
  botUserId              String?             @db.Uuid
  telegramUserId         BigInt?
  fullName               String              @db.VarChar(100)
  telegramTag            String              @db.VarChar(50)
  group                  String              @db.VarChar(10)
  birthDate              DateTime?
  phoneNumber            String?             @db.VarChar(20)
  source                 RegistrationSource  @default(WEB)
  payment                RegistrationPayment @default(NONE)
  paymentStatus          PaymentStatus       @default(NOT_REQUIRED)
  paymentRejectionReason String?             @db.Text
  ticketCode             String              @unique @default(uuid()) @db.Uuid
  receiptUrl             String?
  attended               Boolean             @default(false)
  attendedAt             DateTime?
  attendedBy             String?             @db.VarChar(100)
  createdAt              DateTime            @default(now())

  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  botUser        BotUser?            @relation(fields: [botUserId], references: [id], onDelete: SetNull)
  answers        EventRegistrationAnswer[]
  votes          Vote[]

  @@index([eventId])
  @@index([telegramUserId])
  @@index([attended])
  @@index([ticketCode])
  @@index([paymentStatus])
}

model EventRegistrationAnswer {
  id             String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  questionId     String @db.Uuid
  value          String @db.Text

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question     EventQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Partner {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @db.VarChar(100)
  logoImage     String?
  websiteLink   String?
  contactName   String? @db.VarChar(100)
  contactMethod String? @db.VarChar(150)
  proposal      String? @db.Text
  isApproved    Boolean @default(false)

  eventPartners EventPartner[]
}

model EventPartner {
  id          String  @id @default(uuid()) @db.Uuid
  partnerId   String? @db.Uuid
  eventId     String  @db.Uuid
  name        String? @db.VarChar(60)
  logoImage   String?
  websiteLink String?

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  votingAwards VotingPartnerAward[]
}

enum ProjectParticipantSource {
  HARVESTED
  MANUAL
}

// People of the "Проєктний" department. HARVESTED rows are captured by the bot
// from the project chat (name + avatar); MANUAL rows are added in the admin to
// cover members the bot can't see. Consumed by a public read endpoint for the
// "Люди проєктного" wall (frontend added separately).
model ProjectParticipant {
  id           String                   @id @default(uuid()) @db.Uuid
  telegramId   BigInt? // null for MANUAL entries
  fullName     String                   @db.VarChar(120)
  telegramTag  String?                  @db.VarChar(50)
  photo        String? // "/uploads/<uuid>.jpg"
  avatarFileId String? // Telegram file_unique_id — skip re-downloading unchanged avatars
  source       ProjectParticipantSource @default(HARVESTED)
  hidden       Boolean                  @default(false)
  lastSeenAt   DateTime                 @default(now())
  createdAt    DateTime                 @default(now())

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // The same person may sit in several department chats.
  @@unique([departmentId, telegramId])
}

model BotUser {
  id          String              @id @default(uuid()) @db.Uuid
  telegramId  BigInt              @unique
  chatId      BigInt
  username    String?             @db.VarChar(50)
  firstName   String?             @db.VarChar(100)
  lastName    String?             @db.VarChar(100)
  fullName    String?             @db.VarChar(120)
  group       String?             @db.VarChar(10)
  birthDate   DateTime?
  phoneNumber String?             @db.VarChar(20)
  isBlocked   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt

  registrations EventRegistration[]
  votes         Vote[]
}

enum VotingStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum CandidateStatus {
  APPROVED
  PENDING
  REJECTED
}

model EventVoting {
  id               String            @id @default(uuid()) @db.Uuid
  eventId          String            @db.Uuid
  title            String            @db.VarChar(120)
  description      String?           @db.Text
  status           VotingStatus      @default(DRAFT)
  onlyRegistered   Boolean           @default(true)
  // Only people checked in at the entrance vote.
  onlyAttended     Boolean           @default(false)
  showResultsLive  Boolean           @default(false)
  allowChangeVote  Boolean           @default(false)
  allowSubmissions Boolean           @default(false)
  submissionsOpen  Boolean           @default(false)
  // What the stage screen shows, set from the admin remote (mode, theme, step…).
  screenState      Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  candidates      VotingCandidate[]
  votes           Vote[]
  partnerAwards   VotingPartnerAward[]

  @@index([eventId])
}

model VotingCandidate {
  id                    String          @id @default(uuid()) @db.Uuid
  votingId              String          @db.Uuid
  name                  String          @db.VarChar(120)
  description           String?         @db.Text
  photoUrl              String?
  order                 Int             @default(0)
  status                CandidateStatus @default(APPROVED)
  submittedByTelegramId BigInt?
  submittedByName       String?         @db.VarChar(120)
  submittedByTag        String?         @db.VarChar(60)
  rejectionReason       String?         @db.Text
  createdAt             DateTime        @default(now())

  voting      EventVoting @relation(fields: [votingId], references: [id], onDelete: Cascade)
  votes       Vote[]
  partnerAwards VotingPartnerAward[]

  @@unique([votingId, submittedByTelegramId])
  @@index([votingId])
  @@index([submittedByTelegramId])
}

model Vote {
  id             String             @id @default(uuid()) @db.Uuid
  votingId       String             @db.Uuid
  candidateId    String             @db.Uuid
  botUserId      String?            @db.Uuid
  telegramId     BigInt
  registrationId String?            @db.Uuid
  createdAt      DateTime           @default(now())

  voting         EventVoting        @relation(fields: [votingId], references: [id], onDelete: Cascade)
  candidate      VotingCandidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  botUser        BotUser?           @relation(fields: [botUserId], references: [id], onDelete: SetNull)
  registration   EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@unique([votingId, telegramId])
  @@index([candidateId])
}

// A partner's special award in a nomination: the partner picks a winner among
// the candidates on their own (votes play no part). Revealed as a separate
// ceremony step after 1st place.
model VotingPartnerAward {
  id             String  @id @default(uuid()) @db.Uuid
  votingId       String  @db.Uuid
  eventPartnerId String  @db.Uuid
  title          String  @db.VarChar(80)
  prize          String? @db.VarChar(160)
  // true: the partner picks via the personal /pick/<code> link;
  // false: the organizer enters the pick the partner told them.
  partnerPicks   Boolean @default(true)
  // The partner's logo under the QR code on the voting screen.
  showLogo       Boolean @default(true)
  code           String  @unique @db.VarChar(32)
  candidateId    String? @db.Uuid
  order          Int     @default(0)
  createdAt      DateTime @default(now())

  voting       EventVoting      @relation(fields: [votingId], references: [id], onDelete: Cascade)
  eventPartner EventPartner     @relation(fields: [eventPartnerId], references: [id], onDelete: Cascade)
  candidate    VotingCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@unique([votingId, eventPartnerId])
}

enum BroadcastTarget {
  EVENT_PARTICIPANTS
  ALL_BOT_USERS
}

enum BroadcastStatus {
  SENDING
  COMPLETED
  INTERRUPTED
}

model BroadcastMessage {
  id              String          @id @default(uuid()) @db.Uuid
  eventId         String?         @db.Uuid
  target          BroadcastTarget @default(EVENT_PARTICIPANTS)
  text            String          @db.Text
  imageUrl        String?
  buttonText      String?         @db.VarChar(60)
  buttonUrl       String?
  recipientsCount Int             @default(0)
  sentCount       Int             @default(0)
  failedCount     Int             @default(0)
  status          BroadcastStatus @default(COMPLETED)
  finishedAt      DateTime?
  createdAt       DateTime        @default(now())

  event           Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
}


model PublicUpload {
  id                String    @id @default(uuid()) @db.Uuid
  filename          String    @unique @db.VarChar(64)
  size              Int
  ipHash            String    @db.VarChar(64)
  createdAt         DateTime  @default(now())
  unreferencedSince DateTime?

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

// ---- Interview booking (separate interview bot) ---------------------------
// Department head = Department.head.telegramTag, admins = presidium members
// (DepartmentMember) by telegramTag. Heads add recruiters and candidates by tag;
// telegramId is bound when the person first opens the mini-app.

enum InterviewStatus {
  PENDING
  PASSED
  FAILED
  NO_SHOW
}

model InterviewRecruiter {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @db.Uuid
  telegramTag  String   @db.VarChar(50)
  telegramId   BigInt?
  name         String?  @db.VarChar(120)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, telegramTag])
  @@index([telegramId])
}

model InterviewCandidate {
  id           String          @id @default(uuid()) @db.Uuid
  departmentId String          @db.Uuid
  telegramTag  String          @db.VarChar(50)
  telegramId   BigInt?
  name         String?         @db.VarChar(120)
  applicantId  String?         @db.Uuid
  status       InterviewStatus @default(PENDING)
  createdAt    DateTime        @default(now())

  department Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  applicant  Applicant?      @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  slot       InterviewSlot?
  notes      InterviewNote[]

  @@unique([departmentId, telegramTag])
  @@index([telegramId])
}

model InterviewSlot {
  id             String    @id @default(uuid()) @db.Uuid
  departmentId   String    @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  // Whoever conducts the interview (recruiter, head or presidium member).
  hostTelegramId BigInt
  hostName       String    @db.VarChar(120)
  candidateId    String?   @unique @db.Uuid
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  department Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  candidate  InterviewCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([departmentId, startsAt])
  @@index([hostTelegramId, startsAt])
}

model InterviewNote {
  id               String   @id @default(uuid()) @db.Uuid
  candidateId      String   @db.Uuid
  authorTelegramId BigInt
  authorName       String   @db.VarChar(120)
  text             String   @db.Text
  createdAt        DateTime @default(now())

  candidate InterviewCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

// ---- Merch shop (@merch_ficebot, /merch, /merch-app) -----------------------
// Integer ids are deliberate: order and product numbers live on Telegram
// buttons, in customers' chats and in the Google Sheet.

enum MerchOrderStatus {
  PENDING
  IN_PROCESS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum MerchDeliveryMethod {
  NOVA_POSHTA
  CAMPUS // legacy, imported orders only
  DAYF
  LATER_CAMPUS
}

// One row, id = 1 (CHECK in the migration): shop settings and the admin chat.
model MerchConfig {
  id              Int      @id @default(1)
  welcomeText     String   @default("Вітаємо у нашому магазині мерчу! 🖤") @db.Text
  currency        String   @default("UAH") @db.VarChar(10)
  monoJarUrl      String   @default("https://send.monobank.ua/") @db.VarChar(255)
  cardNumber      String?  @db.VarChar(20)
  dayfEnabled     Boolean  @default(false)
  adminChatId     BigInt?
  adminChatTitle  String?  @db.VarChar(255)
  ordersThreadId  Int?
  supportThreadId Int?
  updatedAt       DateTime @default(now()) @updatedAt
}

// Someone who started the merch bot, opened its Mini App or linked the site.
// Not BotUser: that row means "started the user bot" and feeds its broadcasts.
model MerchCustomer {
  telegramId  BigInt    @id
  // Lowercase, without @.
  username    String?   @db.VarChar(255)
  firstName   String?   @db.VarChar(255)
  lastName    String?   @db.VarChar(255)
  // Last known: the bot cannot write to this person. /start clears it.
  blockedBot  Boolean   @default(false)
  // What their next private message answers: support, mono, card, welcome, broadcast.
  prompt      String?   @db.VarChar(20)
  promptUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  links      MerchLink[]
  recipients MerchRecipient[]
  orders     MerchOrder[]
}

// One browser. First a one-time link token for /start link_<token>, then, once
// confirmed in the bot and polled, the session that browser sends as x-merch-token.
model MerchLink {
  id          Int      @id @default(autoincrement())
  linkToken   String?  @unique @db.VarChar(32)
  // sha256 hex of the session token. The token itself is never stored.
  sessionHash String?  @unique @db.VarChar(64)
  telegramId  BigInt?
  // 15 minutes while pending, 180 days once claimed.
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  customer MerchCustomer? @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade)

  @@index([telegramId])
  @@index([expiresAt])
}

model MerchRecipient {
  id         Int      @id @default(autoincrement())
  telegramId BigInt
  fullName   String   @db.VarChar(255)
  // +380XXXXXXXXX on new rows.
  phone      String   @db.VarChar(50)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer MerchCustomer @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade)

  @@unique([telegramId, fullName, phone])
}

model MerchCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  order Int    @default(0)

  products  MerchProduct[]
  templates MerchTemplate[]
}

model MerchTag {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  order Int    @default(0)

  products MerchProductTag[]
}

model MerchProduct {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String   @db.Text
  // false means archived.
  isActive    Boolean  @default(true)
  // Lower shows first. A new product takes min - 1, the import seeds -id.
  order       Int      @default(0)
  categoryId  Int?
  // Client key of the last admin save: spots a retry and a form that went stale.
  saveKey     String?  @unique @db.VarChar(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  category   MerchCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   MerchVariant[]
  photos     MerchPhoto[]
  tags       MerchProductTag[]
  groups     MerchProductGroup[]
  orderItems MerchOrderItem[]

  @@index([isActive, order])
  @@index([categoryId])
}

model MerchProductTag {
  productId Int
  tagId     Int

  product MerchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     MerchTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// One row per (size, colour). Updated in place, never deleted and re-inserted.
model MerchVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  // NO_SIZE ("-") for products without sizes; never shown.
  size      String  @db.VarChar(20)
  // '' means no colour, so the unique key below really holds.
  color     String  @default("") @db.VarChar(30)
  price     Decimal @db.Decimal(10, 2)
  // Null means no stock limit. CHECK >= 0 in the migration.
  stock     Int?
  // sizeIndex * 100 + colorIndex: keeps both matrix axes in their order.
  order     Int     @default(0)

  product    MerchProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems MerchOrderItem[]

  @@unique([productId, size, color])
}

// One photo per colour; color '' is the photo of a product without colours.
model MerchPhoto {
  id           Int     @id @default(autoincrement())
  productId    Int
  color        String  @default("") @db.VarChar(30)
  url          String
  thumbUrl     String
  // Telegram file id it was imported from, so a repeated import skips the download.
  sourceFileId String? @db.VarChar(255)

  product MerchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, color])
}

// Values copied into a new product form; later edits touch no product.
// Stock is not part of a template.
model MerchTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  categoryId  Int?
  description String   @default("") @db.Text
  // Plain ints, no foreign keys. A dead group raises a warning in the form.
  tagIds      Int[]    @default([])
  groupIds    Int[]    @default([])
  sizes       String[] @default([])
  colors      String[] @default([])
  // [{ size, color, price }]; a missing pair is a combination not sold.
  prices      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  category MerchCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
}

model MerchGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())

  members  MerchGroupMember[]
  products MerchProductGroup[]
}

// Exactly one of telegramId and username (CHECK in the migration).
model MerchGroupMember {
  id         Int      @id @default(autoincrement())
  groupId    Int
  telegramId BigInt?
  // Lowercase, without @.
  username   String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  group MerchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, telegramId])
  @@unique([groupId, username])
  @@index([telegramId])
  @@index([username])
}

// No rows for a product: everyone sees it.
model MerchProductGroup {
  productId Int
  groupId   Int

  product MerchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   MerchGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
}

model MerchPickupSlot {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  // HH:MM, Kyiv time.
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)
  // A slot with orders is deactivated instead of deleted.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orders MerchOrder[]

  @@index([date])
}

model MerchOrder {
  id                    Int                  @id @default(autoincrement())
  telegramId            BigInt
  status                MerchOrderStatus     @default(PENDING)
  deliveryMethod        MerchDeliveryMethod?
  address               String               @db.Text
  phone                 String               @db.VarChar(50)
  recipientName         String?              @db.VarChar(255)
  totalAmount           Decimal              @db.Decimal(10, 2)
  currency              String               @default("UAH") @db.VarChar(10)
  // New orders: /uploads URL, kept alive by the upload GC union.
  receiptUrl            String?
  // Imported orders: Telegram file id, valid for this bot only.
  receiptFileId         String?              @db.VarChar(255)
  // Client generated; a repeated submit returns the same order. Null on imports.
  clientKey             String?              @db.VarChar(64)
  // Lines shown on the card: short stock, changed total, gone items.
  warnings              String[]             @default([])
  adminMessageId        Int?
  // Who took it in work, shown when completed.
  processedByAdmin      String?              @db.VarChar(255)
  // Who pressed the last status button; the card and the sheet show it.
  statusBy              String?              @db.VarChar(255)
  pickupSlotId          Int?
  needsIndividualPickup Boolean              @default(false)
  // Work the sync loop still owes. Imported orders keep false, so they are
  // never re-sent. Set in the same write that changes the order.
  cardDirty             Boolean              @default(false)
  notifyDirty           Boolean              @default(false)
  pickupDirty           Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @default(now()) @updatedAt

  customer   MerchCustomer    @relation(fields: [telegramId], references: [telegramId], onDelete: Restrict)
  pickupSlot MerchPickupSlot? @relation(fields: [pickupSlotId], references: [id], onDelete: Restrict)
  items      MerchOrderItem[]

  @@unique([telegramId, clientKey])
  @@index([telegramId, createdAt])
  @@index([status])
  @@index([pickupSlotId])
}

// Snapshot lines: history survives a deleted product or variant.
model MerchOrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  productId  Int?
  variantId  Int?
  title      String  @db.VarChar(255)
  size       String  @db.VarChar(20)
  color      String  @default("") @db.VarChar(30)
  unitPrice  Decimal @db.Decimal(10, 2)
  quantity   Int
  // Units really taken from stock (floor at 0). A cancel returns exactly this.
  stockTaken Int     @default(0)

  order   MerchOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product MerchProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant MerchVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ---- Шари: teachers' bonuses for students (FICE birthday) -----------------
// Teachers work through a personal link (token); starostas and the presidium
// sign in with the Telegram Login Widget of the user bot. Each award's random
// id is what its certificate's QR code checks, so it must stay unguessable.

model ShariTeacher {
  id        String    @id @default(uuid()) @db.Uuid
  fullName  String    @unique @db.VarChar(120)
  email     String?   @db.VarChar(255)
  telegram  String?   @db.VarChar(120)
  token     String    @unique @db.VarChar(64)
  // Campus schedule: [{ discipline, groups: [...] }].
  courses   Json      @default("[]")
  openedAt  DateTime?
  createdAt DateTime  @default(now())

  shari Shara[]
}

model Shara {
  id         String   @id @default(uuid()) @db.Uuid
  teacherId  String   @db.Uuid
  discipline String   @db.VarChar(255)
  // null = a shara for a whole elective discipline: its teacher writes the
  // recipients, each with their own group (ShariAward.group).
  group      String?  @db.VarChar(20)
  bonus      String   @db.VarChar(300)
  condition  String?  @db.VarChar(300)
  quantity   Int
  createdAt  DateTime @default(now())

  teacher ShariTeacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  awards  ShariAward[]

  @@index([group])
  @@index([teacherId])
}

model ShariAward {
  id          String   @id @db.Uuid
  sharaId     String   @db.Uuid
  // Position among the shara's `quantity` places, as the starosta fills them.
  slot        Int
  studentName String   @db.VarChar(120)
  // The student's own group on a shara without one; null = the shara's group.
  group       String?  @db.VarChar(20)
  createdAt   DateTime @default(now())

  shara Shara @relation(fields: [sharaId], references: [id], onDelete: Cascade)

  @@unique([sharaId, slot])
}

/// Who chose which elective this autumn: the dean's office workbook, replaced
/// as a whole on import. `discipline` is disciplineKey() of the course name.
model ShariElectiveStudent {
  discipline String @db.VarChar(255)
  group      String @db.VarChar(20)
  fullName   String @db.VarChar(120)

  @@id([discipline, group, fullName])
}

model ShariStarosta {
  group       String  @id @db.VarChar(20)
  telegramTag String  @db.VarChar(50)
  telegramId  BigInt?
}

/// Shari admins outside the presidium, added by the presidium on /shari.
/// Bound to the Telegram account on first sign-in, like starostas.
model ShariAdmin {
  telegramTag String   @id @db.VarChar(50)
  telegramId  BigInt?
  addedBy     String   @db.VarChar(120)
  createdAt   DateTime @default(now())
}

model ShariStudent {
  id       String @id @default(uuid()) @db.Uuid
  group    String @db.VarChar(20)
  fullName String @db.VarChar(120)

  @@unique([group, fullName])
}

