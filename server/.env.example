# Copy to `.env` and adjust for your environment.

# PostgreSQL connection string.
# Local dev (Postgres from docker-compose is published on host port 5433):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fice?schema=public"

# Port the API listens on.
PORT=3001

# --- Telegram admin (optional) ---
# Bot token from @BotFather. Without it the bot is skipped and admin-only
# (write) endpoints are rejected unless AUTH_DISABLED=true.
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL of the admin Mini App (e.g. an ngrok tunnel in dev).
MINI_APP_URL=

# Telegram chat id of the admin group. Only members of this group may write.
# Add the bot to the group and grab the id (e.g. via @getidsbot). If left empty,
# any authenticated Telegram user is allowed.
ADMIN_GROUP_CHAT_ID=

# Telegram usernames pinged when a new PARTNER application arrives
# (head of partnerships and head of the student council).
PARTNERSHIP_HEAD_TG=
COUNCIL_HEAD_TG=

# Dev-only: set to "true" to bypass the Telegram auth guard on write endpoints.
# NEVER enable in production.
AUTH_DISABLED=false

# --- Monobank jar auto-sync (optional) ---
# Personal API token of the jar owner (https://api.monobank.ua/ -> "Отримати токен").
# When set, the server polls every 60s and updates the "collected amount" and
# "recent donations" of any fundraiser whose Monobank jar id (monoJarId) is set.
# Leave empty to manage amounts manually from the admin panel.
MONOBANK_TOKEN=
