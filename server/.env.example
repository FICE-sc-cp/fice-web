# server/.env for running the API on the host (`npm run start:dev`).
# In Docker the server gets its env from docker compose and the root .env
# instead; see ../.env.example for every variable and the production values.

# [required] PostgreSQL connection string. Postgres from docker compose is
# published on 127.0.0.1:5433; use the password from POSTGRES_PASSWORD in the
# root .env (`postgres` for a volume created before that variable existed).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fice?schema=public"

# [optional] Port the API listens on. Default: 3001
PORT=3001

# [optional] `production` enables the startup checks; leave empty locally.
APP_ENV=

# [optional] Where uploads are stored. Default: ./uploads
UPLOAD_DIR=./uploads

# [optional] Comma-separated CORS origins. Empty reflects any origin.
CORS_ORIGIN=

# --- Telegram (all optional locally; use separate dev bots) ---

# Admin bot. Without it the admin bot is skipped and admin endpoints are
# rejected unless AUTH_DISABLED=true.
TELEGRAM_BOT_TOKEN=

# HTTPS URL of the admin Mini App, e.g. https://<tunnel-host>/admin.
MINI_APP_URL=

# Telegram chat id of the admin group whose members are admins.
ADMIN_GROUP_CHAT_ID=

# Student bot: a different bot than TELEGRAM_BOT_TOKEN, and its username
# without "@".
USER_BOT_TOKEN=
USER_BOT_USERNAME=
USER_MINI_APP_NAME=app

# HTTPS URL of the student Mini App, and the public site origin.
USER_MINI_APP_URL=
PUBLIC_WEB_URL=

# Channel for announcements and the partnerships chat ("chatId/threadId" for
# a forum topic).
TELEGRAM_CHANNEL_ID=
PARTNERSHIP_CHAT_ID=

# Telegram usernames pinged when a new partner application arrives.
PARTNERSHIP_HEAD_TG=
COUNCIL_HEAD_TG=

# Dev-only: `true` bypasses Telegram auth on admin endpoints. Refused when
# APP_ENV=production.
AUTH_DISABLED=false

# Dev-only: set to 1 to let `npm run db:seed` wipe and refill the database.
ALLOW_DESTRUCTIVE_SEED=
