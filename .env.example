# Root .env read by docker compose. Copy to `.env` and fill in.

# [required] Password of the `postgres` superuser. Compose refuses to start without it,
# and DATABASE_URL for the server is built from it. Use URL-safe characters only
# (letters, digits, `-`, `_`, `.`, `~`).
# Postgres applies it only when the data volume is first created. An existing
# local `fice_pg_data` volume keeps the old password `postgres`, so on a laptop
# that already has the volume set POSTGRES_PASSWORD=postgres.
POSTGRES_PASSWORD=
