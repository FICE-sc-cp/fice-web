# Root .env read by docker compose (copy to `.env`).
# [required]       needed everywhere, compose refuses to start without it
# [required: prod] the server refuses to start without it when APP_ENV=production
# [optional]       feature is skipped or a default is used when empty
# Values after "prod:" are the production values for https://fice-sc.kpi.ua.

# --- Database -------------------------------------------------------------

# [required] Password of the `postgres` superuser. DATABASE_URL for the server
# is built from it, so use URL-safe characters only (letters, digits, - _ . ~).
# Postgres applies it only when the data volume is first created. An existing
# local `fice_pg_data` volume keeps the old password `postgres`, so on a laptop
# that already has the volume set POSTGRES_PASSWORD=postgres.
# prod: a long random value, set before the first `docker compose up`.
POSTGRES_PASSWORD=

# --- Mode -----------------------------------------------------------------

# [optional] `production` turns on the startup checks below, refuses
# AUTH_DISABLED=true, hides /api/docs and blocks the demo seed.
# Default: development. prod: production
APP_ENV=

# [optional] Compose profiles to enable. `prod` adds the Caddy ingress
# (ports 80/443, TLS). Leave empty on a laptop. prod: prod
COMPOSE_PROFILES=

# --- Telegram bots ----------------------------------------------------------

# [required: prod] Admin bot token from @BotFather. Without it the admin bot is
# skipped and admin endpoints are rejected (unless AUTH_DISABLED=true).
TELEGRAM_BOT_TOKEN=

# [required: prod] Student bot token. Must be a different bot than
# TELEGRAM_BOT_TOKEN. Never put the production tokens in a laptop's .env:
# a second poller makes Telegram cut off the production one.
USER_BOT_TOKEN=

# [required: prod] Student bot username without "@". The only source of the
# bot name: deep links, channel buttons, the projector QR (baked into the web
# image at build time, so rebuild `web` after changing it).
USER_BOT_USERNAME=

# [optional] Short name of the student Mini App registered in @BotFather
# (/newapp), used in t.me/<bot>/<name> links. Default: app
USER_MINI_APP_NAME=

# [required: prod] Telegram chat id of the admin group. Only its members get
# admin rights; the admin bot must be a member. prod: the group's numeric id
ADMIN_GROUP_CHAT_ID=

# [optional] Channel the admin bot posts announcements to (bot must be admin).
TELEGRAM_CHANNEL_ID=

# [optional] Chat for partner applications; "chatId/threadId" for a forum topic.
PARTNERSHIP_CHAT_ID=

# [optional] Telegram usernames pinged on a new partner application.
PARTNERSHIP_HEAD_TG=
COUNCIL_HEAD_TG=

# --- Public URLs ------------------------------------------------------------

# [required: prod] HTTPS URL of the admin Mini App (the admin is served under
# /admin). For a dev tunnel use https://<tunnel-host>/admin.
# prod: https://fice-sc.kpi.ua/admin
MINI_APP_URL=

# [required: prod] HTTPS URL of the student Mini App.
# prod: https://fice-sc.kpi.ua/app
USER_MINI_APP_URL=

# [required: prod] Public origin of the website, used in bot and channel links.
# prod: https://fice-sc.kpi.ua
PUBLIC_WEB_URL=

# [required: prod] Comma-separated origins allowed by CORS. Empty reflects any
# origin (fine locally). prod: https://fice-sc.kpi.ua
CORS_ORIGIN=

# --- Development only -------------------------------------------------------

# [optional] `true` opens admin endpoints without Telegram auth. Never in
# production: the server refuses to start with it when APP_ENV=production.
AUTH_DISABLED=

# --- Google Sheets sync (optional) ------------------------------------------
# Синхронізація заявок на вступ до Студради з Google Таблицею

# Варіант 1: Через Google Cloud Service Account (Google Sheets API v4)
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Заявки
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Варіант 2: Через Google Apps Script Webhook (найпростіший)
GOOGLE_SHEETS_WEBHOOK_URL=
